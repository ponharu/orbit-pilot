{
  "name": "orbit-pilot",
  "version": "0.0.0-semantic-release",
  "description": "A Codex-powered GitHub issue pilot that autonomously carries assigned work through code, PRs, and review.",
  "keywords": [
    "agent",
    "ai",
    "bun",
    "cli",
    "codex",
    "github",
    "issues",
    "pull-request"
  ],
  "homepage": "https://github.com/ponharu/orbit-pilot#readme",
  "bugs": {
    "url": "https://github.com/ponharu/orbit-pilot/issues"
  },
  "license": "MIT",
  "author": "ponharu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponharu/orbit-pilot.git"
  },
  "bin": {
    "orbit-pilot": "src/index.ts"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "orbit-pilot.example.toml"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "format": "bunx oxfmt . --write",
    "lint": "bunx oxlint .",
    "hooks:install": "bunx lefthook install",
    "check": "tsc --noEmit",
    "test": "bun test ./tests/unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@octokit/graphql": "9.0.5",
    "@openai/codex-sdk": "0.159.2",
    "smol-toml": "1.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/bun": "1.4.2",
    "@types/node": "25.9.8",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "lefthook": "2.1.15",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "packageManager": "bun@1.4.2"
}
